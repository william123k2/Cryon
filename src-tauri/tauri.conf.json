{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cryon",
  "version": "0.2.0",
  "identifier": "dev.cryon.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Cryon — Minecraft Launcher",
        "width": 1240,
        "height": 680,
        "minWidth": 640,
        "minHeight": 600,
        "backgroundColor": "#070D1B"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "shortDescription": "Launcher Minecraft com identidade Cryon",
    "category": "Game",
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "PortugueseBR"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}